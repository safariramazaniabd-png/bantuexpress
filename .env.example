# ============================================================================
# BantuExpress - Variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs reelles.
# Ne jamais committer le fichier `.env` reel.
# ============================================================================

NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS
DATABASE_URL="postgresql://bantuexpress:motdepasse@localhost:5432/bantuexpress_dev?schema=public"

# JWT - generer un secret fort en production (ex: openssl rand -hex 64)
JWT_SECRET="a-remplacer-par-un-secret-fort-en-production"
JWT_EXPIRATION="3600s"

# CORS - origine autorisee du frontend (mobile app / web) en production.
# Laisser vide en developpement pour autoriser toute origine.
CORS_ORIGIN=

# CSRF - secret pour la protection CSRF (double-submit cookie).
# Generer un secret fort en production (ex: openssl rand -hex 32).
# Optionnel en developpement (valeur par defaut utilisee).
CSRF_SECRET=

# Sentry DSN - tracking d'erreurs en production.
# Optionnel. Laisser vide en developpement pour desactiver Sentry.
SENTRY_DSN=

# URL du frontend utilisee pour les liens dans les emails (reset password, etc.)
# En production, remplacer par l'URL reelle du frontend.
FRONTEND_URL=http://localhost:3001

# Resend (fournisseur email) - https://resend.com
# En development, les emails sont logs en console sans envoyer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@bantu-express.com

# Africa's Talking (fournisseur SMS) - https://africastalking.com
# En development, les SMS sont logs en console sans envoyer.
# Utiliser "sandbox" pour les tests.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=BANTU

# Limite globale de requetes par minute et par IP (ThrottlerGuard).
# Defaut: 100
THROTTLE_LIMIT=100

# Seed uniquement (npm run prisma:seed) - mot de passe initial du compte
# administrateur. Optionnel pour l'application : jamais requis au demarrage,
# jamais valide dans env.validation.ts. A definir uniquement avant un seed.
# Ne jamais renseigner de valeur reelle dans ce fichier.
ADMIN_INITIAL_PASSWORD=

# Seed uniquement (npm run prisma:seed) - mot de passe partage des comptes de
# demonstration (individu, professionnel, coursier). Meme regles que
# ADMIN_INITIAL_PASSWORD : optionnel pour l'application, remplit uniquement
# avant un seed. Ne jamais renseigner de valeur reelle dans ce fichier.
SEED_DEMO_PASSWORD=

# OAuth - binding d'applications (aud/azp). Optionnels en local, requis
# pour activer le login social en production. Sans ces valeurs, les
# endpoints /auth/google, /auth/apple, /auth/facebook renvoient 503.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
