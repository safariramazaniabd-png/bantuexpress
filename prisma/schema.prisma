generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp]
}

enum UserRole {
  INDIVIDUAL
  PROFESSIONAL
  ADMIN
  EMERGENCY
}

enum AddressType {
  PERSONAL
  PROFESSIONAL
}

enum LandmarkCategory {
  ROUTE
  NEIGHBORHOOD
  BUILDING
  MONUMENT
  PARK
  SCHOOL
  HOSPITAL
  MARKET
  OTHER
}

enum IdentityDocumentType {
  NATIONAL_ID
  VOTER_CARD
  PASSPORT
  DRIVERS_LICENSE
}

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique
  phone                   String    @unique
  passwordHash            String
  role                    UserRole  @default(INDIVIDUAL)
  isActive                Boolean   @default(true)
  refreshToken            String?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  verificationCode        String?
  verificationCodeExpiresAt DateTime?
  resetPasswordToken      String?
  resetPasswordExpiresAt  DateTime?
  googleId                String?   @unique
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profile                 Profile?
  addresses               Address[]
  landmarks               Landmark[]
}

model Profile {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @unique @db.Uuid
  firstName              String                @default("")
  lastName               String                @default("")
  avatarUrl              String?
  profession             String?
  languages              String[]              @default([])
  secondaryPhones        String[]              @default([])
  identityDocumentType   IdentityDocumentType?
  identityDocumentNumber String?
  personalQrCode         String?               @unique
  isPublic               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user                   User                  @relation(fields: [userId], references: [id])
}

model Address {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  label     String?
  type      AddressType @default(PERSONAL)
  avenue    String?
  quartier  String?
  city      String
  province  String      @default("")
  country   String      @default("CD")
  isPrimary Boolean     @default(false)
  isPublic  Boolean     @default(false)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@index([city, province])
}

model Landmark {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @db.Uuid
  name        String
  category    LandmarkCategory @default(OTHER)
  description String?
  address     String?
  city        String
  province    String           @default("")
  country     String           @default("CD")
  latitude    Float
  longitude   Float
  isPublic    Boolean          @default(true)
  verifiedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User?            @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([city, province])
  @@index([deletedAt])
}
