generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp]
}

enum UserRole {
  INDIVIDUAL
  PROFESSIONAL
  ADMIN
  EMERGENCY
  COURIER
  TRANSPORTER
  DELIVERY_AGENCY
  NGO
  POLICE
  FIREFIGHTER
  AMBULANCE
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  VERIFY_EMAIL
  VERIFY_PHONE
  WHATSAPP
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
}

enum AddressType {
  HOME
  BUSINESS
  OFFICE
  SHOP
  SCHOOL
  FARM
  ORGANIZATION
  EVENT
  OTHER
}

enum BusinessType {
  ENTERPRISE
  NGO
  GOVERNMENT
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum EmergencyType {
  POLICE
  FIRE
  MEDICAL
  ACCIDENT
  NATURAL_DISASTER
  OTHER
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum LandmarkCategory {
  ROUTE
  NEIGHBORHOOD
  BUILDING
  MONUMENT
  PARK
  SCHOOL
  HOSPITAL
  MARKET
  OTHER
}

enum IdentityDocumentType {
  NATIONAL_ID
  VOTER_CARD
  PASSPORT
  DRIVERS_LICENSE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FAKE
  DUPLICATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model User {
  id                        String    @id @default(uuid()) @db.Uuid
  email                     String    @unique
  phone                     String    @unique
  passwordHash              String
  role                      UserRole  @default(INDIVIDUAL)
  isActive                  Boolean   @default(true)
  refreshToken              String?
  refreshTokenJti           String?
  emailVerifiedAt           DateTime?
  phoneVerifiedAt           DateTime?
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  resetPasswordToken        String?
  resetPasswordExpiresAt    DateTime?
  googleId                  String?   @unique
  appleId                   String?   @unique
  facebookId                String?   @unique
  whatsappId                String?   @unique
  twoFactorSecret           String?
  twoFactorEnabled          Boolean   @default(false)
  failedLoginAttempts       Int       @default(0)
  lockedUntil               DateTime?
  passwordChangedAt         DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  profile                  Profile?
  addresses                Address[]
  landmarks                Landmark[]
  positions                UserPosition[]
  routes                   Route[]
  qrCodes                  QrCode[]
  businessProfiles         BusinessProfile[]
  businessMemberships      BusinessMember[]
  clientDeliveries         Delivery[]                @relation("DeliveryClient")
  courierDeliveries        Delivery[]                @relation("DeliveryCourier")
  emergencyReports         Emergency[]               @relation("EmergencyReporter")
  emergencyResponses       Emergency[]               @relation("EmergencyResponder")
  reports                  ContentReport[]           @relation("ContentReportReporter")
  reviewedReports          ContentReport[]           @relation("ContentReportReviewer")
  auditLogs                AdminAuditLog[]
  organizedEvents          Event[]                   @relation("EventOrganizer")
  favorites                Favorite[]
  reviews                  Review[]
  notifications            Notification[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  shareLinks               ShareLink[]
  refreshTokenSessions     RefreshTokenSession[]
  loginAttempts            LoginAttempt[]
  otpCodes                 OtpCode[]
  passwordHistory          PasswordHistory[]
  roleAssignments          UserRoleAssignment[]
}

model RefreshTokenSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  jti        String    @unique
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  success    Boolean
  method     String   @default("password")
  ipAddress  String?
  userAgent  String?
  failReason String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userAssignments UserRoleAssignment[]

  @@index([slug])
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  identifier  String
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose, createdAt])
  @@index([userId])
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @unique @db.Uuid
  firstName              String                @default("")
  lastName               String                @default("")
  avatarUrl              String?
  gender                 String?
  birthDate              DateTime?
  profession             String?
  languages              String[]              @default([])
  secondaryPhones        String[]              @default([])
  identityDocumentType   IdentityDocumentType?
  identityDocumentNumber String?
  identityDocumentPhoto  String?
  digitalSignature       String?
  verifiedAt             DateTime?
  personalQrCode         String?               @unique
  isPublic               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  label      String?
  type       AddressType @default(HOME)
  avenue     String?
  quartier   String?
  city       String
  province   String      @default("")
  country    String      @default("CD")
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean     @default(false)
  isPublic   Boolean     @default(false)
  expiresAt  DateTime?
  shareToken String?     @unique
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@index([city, province])
}

model Landmark {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @db.Uuid
  name        String
  category    LandmarkCategory @default(OTHER)
  description String?
  address     String?
  city        String
  province    String           @default("")
  country     String           @default("CD")
  latitude    Float
  longitude   Float
  isPublic    Boolean          @default(true)
  verifiedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([city, province])
  @@index([deletedAt])
}

model UserPosition {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  latitude   Float
  longitude  Float
  accuracy   Float?
  source     String   @default("gps")
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
  @@index([recordedAt])
}

model Route {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  name        String?
  originLat   Float
  originLng   Float
  destLat     Float
  destLng     Float
  distanceKm  Float?
  durationMin Int?
  polyline    String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

model QrCode {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @db.Uuid
  entityType    String
  entityId      String
  code          String    @unique
  scans         Int       @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@unique([entityType, entityId])
  @@index([code])
}

model BusinessProfile {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  name        String
  type        BusinessType @default(ENTERPRISE)
  description String?
  sector      String?
  logoUrl     String?
  website     String?
  email       String?
  phone       String?
  city        String
  province    String       @default("")
  country     String       @default("CD")
  isVerified  Boolean      @default(false)
  isPublic    Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  members      BusinessMember[]
  openingHours OpeningHour[]
  products     Product[]

  @@index([type, isVerified])
  @@index([city, province])
  @@index([deletedAt])
}

model BusinessMember {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  role       String   @default("member")
  joinedAt   DateTime @default(now())

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @db.Uuid
  courierId       String?        @db.Uuid
  status          DeliveryStatus @default(PENDING)
  packageSize     PackageSize    @default(MEDIUM)
  description     String?
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  dropoffAddress  String
  dropoffLat      Float
  dropoffLng      Float
  distanceKm      Float?
  price           Decimal?       @db.Decimal(10, 2)
  proofPhoto      String?
  proofSignature  String?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client   User               @relation("DeliveryClient", fields: [clientId], references: [id])
  courier  User?              @relation("DeliveryCourier", fields: [courierId], references: [id])
  tracking DeliveryTracking[]

  @@index([status])
  @@index([clientId])
  @@index([courierId])
}

model DeliveryTracking {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
}

model Emergency {
  id              String            @id @default(uuid()) @db.Uuid
  reporterId      String            @db.Uuid
  responderId     String?           @db.Uuid
  type            EmergencyType     @default(OTHER)
  severity        EmergencySeverity @default(MEDIUM)
  status          EmergencyStatus   @default(REPORTED)
  description     String?
  latitude        Float
  longitude       Float
  address         String?
  resolvedNotes   String?
  responseTimeMin Int?
  resolvedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reporter  User  @relation("EmergencyReporter", fields: [reporterId], references: [id])
  responder User? @relation("EmergencyResponder", fields: [responderId], references: [id])

  @@index([status, type])
  @@index([reporterId])
  @@index([responderId])
}

model ContentReport {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @db.Uuid
  entityType   String
  entityId     String
  reason       ReportReason @default(OTHER)
  description  String?
  status       ReportStatus @default(PENDING)
  reviewedById String?      @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User  @relation("ContentReportReporter", fields: [reporterId], references: [id])
  reviewedBy User? @relation("ContentReportReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([entityType, entityId])
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String
  targetType String?
  targetId   String?
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model OpeningHour {
  id                String @id @default(uuid()) @db.Uuid
  businessProfileId String @db.Uuid
  dayOfWeek         Int
  open              String
  close             String

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([businessProfileId, dayOfWeek])
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  businessProfileId String   @db.Uuid
  name              String
  description       String?
  price             Decimal? @db.Decimal(10, 2)
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([businessProfileId])
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([userId])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  entityType String
  entityId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  organizerId String    @db.Uuid
  name        String
  description String?
  address     String?
  latitude    Float?
  longitude   Float?
  startDate   DateTime
  endDate     DateTime?
  qrCode      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizer User @relation("EventOrganizer", fields: [organizerId], references: [id])

  @@index([organizerId])
  @@index([startDate])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  userId         String @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  content        String
  type           MessageType @default(TEXT)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?     @db.JsonB
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([createdAt])
}

model ShareLink {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  entityType String
  entityId   String
  token      String    @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  @@index([slug])
  @@index([parentId])
}
