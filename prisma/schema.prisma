generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp]
}

enum UserRole {
  INDIVIDUAL
  PROFESSIONAL
  ADMIN
  EMERGENCY
}

enum AddressType {
  PERSONAL
  PROFESSIONAL
}

enum BusinessType {
  ENTERPRISE
  NGO
  GOVERNMENT
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum LandmarkCategory {
  ROUTE
  NEIGHBORHOOD
  BUILDING
  MONUMENT
  PARK
  SCHOOL
  HOSPITAL
  MARKET
  OTHER
}

enum IdentityDocumentType {
  NATIONAL_ID
  VOTER_CARD
  PASSPORT
  DRIVERS_LICENSE
}

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique
  phone                   String    @unique
  passwordHash            String
  role                    UserRole  @default(INDIVIDUAL)
  isActive                Boolean   @default(true)
  refreshToken            String?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  verificationCode        String?
  verificationCodeExpiresAt DateTime?
  resetPasswordToken      String?
  resetPasswordExpiresAt  DateTime?
  googleId                String?   @unique
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profile                 Profile?
  addresses               Address[]
  landmarks               Landmark[]
  positions               UserPosition[]
  routes                  Route[]
  qrCodes                 QrCode[]
  businessProfiles        BusinessProfile[]
  businessMemberships     BusinessMember[]
  clientDeliveries        Delivery[]       @relation("DeliveryClient")
  courierDeliveries       Delivery[]       @relation("DeliveryCourier")
}

model Profile {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @unique @db.Uuid
  firstName              String                @default("")
  lastName               String                @default("")
  avatarUrl              String?
  profession             String?
  languages              String[]              @default([])
  secondaryPhones        String[]              @default([])
  identityDocumentType   IdentityDocumentType?
  identityDocumentNumber String?
  personalQrCode         String?               @unique
  isPublic               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user                   User                  @relation(fields: [userId], references: [id])
}

model Address {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  label     String?
  type      AddressType @default(PERSONAL)
  avenue    String?
  quartier  String?
  city      String
  province  String      @default("")
  country   String      @default("CD")
  isPrimary Boolean     @default(false)
  isPublic  Boolean     @default(false)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@index([city, province])
}

model Landmark {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @db.Uuid
  name        String
  category    LandmarkCategory @default(OTHER)
  description String?
  address     String?
  city        String
  province    String           @default("")
  country     String           @default("CD")
  latitude    Float
  longitude   Float
  isPublic    Boolean          @default(true)
  verifiedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User?            @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([city, province])
  @@index([deletedAt])
}

model UserPosition {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  latitude   Float
  longitude  Float
  accuracy   Float?
  source     String   @default("gps")
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
  @@index([recordedAt])
}

model Route {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  name        String?
  originLat   Float
  originLng   Float
  destLat     Float
  destLng     Float
  distanceKm  Float?
  durationMin Int?
  polyline    String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model QrCode {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @db.Uuid
  entityType    String
  entityId      String
  code          String    @unique
  scans         Int       @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())

  user          User?     @relation(fields: [userId], references: [id])

  @@unique([entityType, entityId])
  @@index([code])
}

model BusinessProfile {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  name        String
  type        BusinessType @default(ENTERPRISE)
  description String?
  sector      String?
  logoUrl     String?
  website     String?
  email       String?
  phone       String?
  city        String
  province    String       @default("")
  country     String       @default("CD")
  isVerified  Boolean      @default(false)
  isPublic    Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  members     BusinessMember[]

  @@index([type, isVerified])
  @@index([city, province])
  @@index([deletedAt])
}

model BusinessMember {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String          @db.Uuid
  userId     String          @db.Uuid
  role       String          @default("member")
  joinedAt   DateTime        @default(now())

  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @db.Uuid
  courierId       String?        @db.Uuid
  status          DeliveryStatus @default(PENDING)
  packageSize     PackageSize    @default(MEDIUM)
  description     String?
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  dropoffAddress  String
  dropoffLat      Float
  dropoffLng      Float
  distanceKm      Float?
  price           Decimal?       @db.Decimal(10, 2)
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client          User               @relation("DeliveryClient", fields: [clientId], references: [id])
  courier         User?              @relation("DeliveryCourier", fields: [courierId], references: [id])
  tracking        DeliveryTracking[]

  @@index([status])
  @@index([clientId])
  @@index([courierId])
}

model DeliveryTracking {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
}
